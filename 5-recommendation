from pathlib import Path

import pandas as pd
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity


PROJECT_ROOT = Path(__file__).resolve().parent
DATA_FILE = PROJECT_ROOT / "data" / "processed" / "netflix_features.csv"
FALLBACK_DATA = PROJECT_ROOT / "netflix_features.csv"


def build_recommendation_model(df: pd.DataFrame):
    """Build normalized titles and a similarity matrix.

    Time: O(n * m + n^2) for n documents and m feature tokens.
    Space: O(n * m + n^2) for vectorized text and the similarity matrix.
    """
    data = df[["title", "listed_in", "description"]].dropna().reset_index(drop=True).copy()
    data["title_lower"] = data["title"].str.lower().str.strip()
    data["content"] = data["listed_in"] + " " + data["description"]
    matrix = TfidfVectorizer(stop_words="english").fit_transform(data["content"])
    similarities = cosine_similarity(matrix)
    return data, similarities


def recommend(data: pd.DataFrame, similarities, title: str, n: int = 5) -> list[str] | str:
    """Return the n closest titles without mutating the model data.

    Time: O(n log n) because the n similarity scores are sorted.
    Space: O(n) for normalized score storage and the returned indices.
    """
    if n < 1:
        return []

    query = title.lower().strip()
    matches = data.index[data["title_lower"] == query].tolist()
    if not matches:
        return "Title not found in dataset"

    index = matches[0]
    scores = sorted(enumerate(similarities[index]), key=lambda item: item[1], reverse=True)
    indices = [item_index for item_index, _ in scores if item_index != index][:n]
    return data.iloc[indices]["title"].tolist()


def main() -> None:
    source = DATA_FILE if DATA_FILE.is_file() else FALLBACK_DATA
    data, similarities = build_recommendation_model(pd.read_csv(source))
    print(recommend(data, similarities, "jaws"))


if __name__ == "__main__":
    main()
